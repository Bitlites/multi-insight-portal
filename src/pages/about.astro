---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch all publications globally to keep sidebar feeds active and synced
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const trendingPosts = sortedPosts.slice(0, 5);

// Dynamic recommended links engine loop
const targetCategories = ['current-affairs', 'technology', 'science', 'finance', 'social-studies'];
const recommendedPosts = targetCategories.map(catId => {
  return sortedPosts.find(p => p.data.category.toLowerCase() === catId);
}).filter(Boolean);
---

<BaseLayout title="About Our Team — Multi-Insight Portal">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    
    <!-- ✅ FRAMEWORK IMPLEMENTATION: TOP LEADERBOARD SLOT -->
    <AdSlot slotType="topSlot" className="mb-10 shadow-sm w-full" />


    <!-- 4-COLUMN STRUCTURAL PATTERN MATRIX GRID -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
      
      <!-- COLUMN 1: LEFT VERTICAL SKYSCRAPER AD CONTAINER -->
			<aside class="hidden lg:flex lg:col-span-1">
				<!-- ✅ FRAMEWORK IMPLEMENTATION: LEFT SKYSCRAPER COMPONENT -->
				<div class="w-full h-full flex flex-col">
					<AdSlot slotType="leftSkyscraper" className="w-full h-full flex-1" />
				</div>
			</aside>

      <!-- COLUMNS 2 & 3: MAIN CARD CONTENT CONTAINER -->
      <div class="md:col-span-2 lg:col-span-2 space-y-6">
        <div class="bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800/80 rounded-2xl p-6 md:p-8 shadow-sm">
          
          <!-- COMPLIANCE TITLE HEADER -->
          <div class="mb-6 border-b border-slate-150 dark:border-slate-800 pb-4">
            <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600 dark:text-blue-400">Platform Profile</span>
            <h1 class="text-3xl md:text-4xl font-black font-['Cabinet_Grotesk'] tracking-tight text-slate-900 dark:text-white mt-1">
              About Our Mission
            </h1>
          </div>

          <!-- PROFILE BODY CONTENT LAYOUT -->
          <div class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 text-sm md:text-[15px] leading-relaxed space-y-6">
            
            <p>Welcome to <strong>Multi-Insight Portal</strong>, a premier independent static journalism intelligence dashboard. Our framework is dedicated to filtering, parsing, and delivering high-utility documentation across modern macroeconomics, technology horizons, scientific developments, and regional demographic trends.</p>

            <blockquote class="border-l-4 border-blue-600 dark:border-blue-500 bg-slate-50 dark:bg-slate-950 px-4 py-3 rounded-r-xl font-medium italic my-5">
              Our Core Directive: Speed, factual accuracy, and structural transparency across modern digital media landscapes.
            </blockquote>

            <h2 class="text-lg font-black font-['Cabinet_Grotesk'] text-slate-900 dark:text-white uppercase pt-2">Our Editorial Values</h2>
            <p>We believe that high-quality information shouldn't be weighed down by bloated script frameworks or heavy, slow server pipelines. By assembling our insights on an advanced static decentralized infrastructure (Astro & Cloudflare Distributed Edge CDN), we ensure our analytical articles load instantly on any mobile device anywhere on the planet.</p>

            <h2 class="text-lg font-black font-['Cabinet_Grotesk'] text-slate-900 dark:text-white uppercase pt-2">Monetization Disclosures</h2>
            <p>To keep our publications completely free and universally accessible, Multi-Insight Portal relies on premium programmatic advertisement networks (such as Google AdSense) to fund ongoing research, data collation, and hosting server costs. All third-party advertising modules operate under strict user data safety rules detailed in our official privacy guidelines.</p>

          </div>

        </div>
      </div>

      <!-- COLUMN 4: RIGHT PANEL SIDEBAR CONTAINER -->
      <aside class="md:col-span-1 lg:col-span-1 space-y-8 self-start md:sticky md:top-24">
        
        <!-- TRENDING CONTAINER -->
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200/60 dark:border-slate-800/60 shadow-sm relative overflow-hidden">
          <h2 class="text-md font-black uppercase tracking-wider text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3.5 mb-5 font-['Cabinet_Grotesk'] flex items-center gap-2">
            <span class="text-xl select-none">🔥</span> Trending
          </h2>
          <ul class="space-y-5">
            {trendingPosts.map((p, index) => (
              <li class="group cursor-pointer flex gap-3.5 items-start">
                <span class="text-xl font-black text-slate-200 dark:text-slate-700 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-none font-['Cabinet_Grotesk']">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="space-y-0.5">
                  <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-snug group-hover:underline">
                    <a href={`/posts/${p.id}`}>{p.data.title}</a>
                  </h4>
                  <span class="text-[9px] text-blue-600 dark:text-blue-400 font-extrabold uppercase tracking-widest block pt-0.5">
                    {p.data.category}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- RECOMMENDED FEED -->
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200/60 dark:border-slate-800/60 shadow-sm relative overflow-hidden">
          <h2 class="text-md font-black uppercase tracking-wider text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3.5 mb-5 font-['Cabinet_Grotesk'] flex items-center gap-2">
            <span class="text-xl select-none">💡</span> Recommended
          </h2>
          <ul class="space-y-4">
            {recommendedPosts.map((p) => (
              <li class="group border-b border-slate-50 dark:border-slate-800/60 pb-3 last:border-0 last:pb-0">
                <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-snug group-hover:text-blue-600 dark:group-hover:text-blue-400">
                  <a href={`/posts/${p.id}`}>{p.data.title}</a>
                </h4>
                <span class="text-[9px] text-slate-400 dark:text-slate-500 font-medium block mt-1 uppercase font-mono">
                  {p.data.category}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <!-- ✅ FRAMEWORK IMPLEMENTATION: FOOTER HIGH IMPRESSION BANNER -->
				<AdSlot slotType="footerHighImpression" className="mt-12" />
      </aside>
    </div>

    <!-- ✅ FRAMEWORK IMPLEMENTATION: FOOTER HIGH IMPRESSION BANNER -->
		<AdSlot slotType="footerHighImpression" className="mt-12" w-full />
  </div>
</BaseLayout>