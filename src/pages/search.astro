---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const trendingPosts = sortedPosts.slice(0, 5);
---

<BaseLayout title="Search Publications - Thank Wisdom">
<div class="w-full px-4 sm:px-6 lg:px-8">
    
    <!-- ✅ FRAMEWORK IMPLEMENTATION: TOP LEADERBOARD SLOT -->
    <AdSlot slotType="topSlot" className="mb-10 shadow-sm w-full" />


    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
      
      <!-- COLUMN 1: LEFT VERTICAL AD CONTAINER -->
      <aside class="hidden lg:flex lg:col-span-1">
        <!-- ✅ FRAMEWORK IMPLEMENTATION: LEFT SKYSCRAPER COMPONENT -->
        <div class="w-full h-full flex flex-col">
          <AdSlot slotType="leftSkyscraper" className="w-full h-full flex-1" />
        </div>
      </aside>

      <!-- COLUMNS 2 & 3: MAIN ACTIVE SEARCH DESK -->
      <div class="md:col-span-2 lg:col-span-2 space-y-6">
        <div class="mb-2 text-center md:text-left">
          <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white font-['Cabinet_Grotesk'] uppercase flex items-center gap-2 justify-center md:justify-start">
            <span class="text-3xl select-none">🔍</span> Discovery Article
          </h1>
          <p class="text-slate-500 dark:text-slate-400 mt-2 text-sm">Query our static data vaults across science, technology, history, and market indexes.</p>
        </div>

        <!-- PAGEFIND UI PIPELINES -->
        <link href="/_pagefind/pagefind-ui.css" rel="stylesheet" />
        <script src="/_pagefind/pagefind-ui.js" is:inline></script>

        <!-- LIVE INPUT NODE WRAPPER -->
        <div id="search-container" class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200/60 dark:border-slate-800/60 shadow-sm min-h-[220px]"></div>

        <script is:inline>
          window.addEventListener('load', () => {
            if (typeof PagefindUI !== 'undefined') {
              new PagefindUI({ 
                element: "#search-container", 
                showSubResults: true,
                showImages: false,
                placeholder: "Type keywords (e.g., Quantum, Inflation, Market)..."
              });
            }
          });
        </script>
      </div>

      <!-- COLUMN 4: RIGHT PANEL TRENDING SIDEBAR -->
      <aside class="md:col-span-1 lg:col-span-1 self-start md:sticky md:top-24">
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200/60 dark:border-slate-800/60 shadow-sm relative overflow-hidden">
          <h2 class="text-md font-black uppercase tracking-wider text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3.5 mb-5 font-['Cabinet_Grotesk'] flex items-center gap-2">
            <span class="text-xl select-none">🔥</span> Trending
          </h2>
          <ul class="space-y-5">
            {trendingPosts.map((p, index) => (
              <li class="group cursor-pointer flex gap-3.5 items-start">
                <span class="text-xl font-black text-slate-200 dark:text-slate-700 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-none font-['Cabinet_Grotesk']">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-snug group-hover:underline">
                  <a href={`/posts/${p.id}`}>{p.data.title}</a>
                </h4>
              </li>
            ))}
          </ul>
        </div>
        <!-- ✅ FRAMEWORK IMPLEMENTATION: FOOTER HIGH IMPRESSION BANNER -->
        <AdSlot slotType="footerHighImpression" className="mt-12" />
      </aside>
    </div>

    <!-- ✅ FRAMEWORK IMPLEMENTATION: FOOTER HIGH IMPRESSION BANNER -->
		<AdSlot slotType="footerHighImpression" className="mt-12" w-full />
  </div>
</BaseLayout>

<style is:global>
  :root {
    --pagefind-ui-primary: #2563eb;
    --pagefind-ui-text: #0f172a;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-font: 'Inter', sans-serif;
  }
  html.dark {
    --pagefind-ui-primary: #3b82f6;
    --pagefind-ui-text: #f8fafc;
    --pagefind-ui-background: #0f172a;
    --pagefind-ui-border: #1e293b;
  }
  .pagefind-ui__search-input {
    font-weight: 500 !important;
    border-radius: 12px !important;
    background-color: var(--pagefind-ui-background) !important;
    color: var(--pagefind-ui-text) !important;
  }
  .pagefind-ui__result {
    border-top: 1px solid var(--pagefind-ui-border) !important;
    padding: 1.25rem 0 !important;
  }
  .pagefind-ui__result-title a {
    font-family: 'Cabinet Grotesk', sans-serif !important;
    font-weight: 800 !important;
    color: var(--pagefind-ui-text) !important;
  }
</style>