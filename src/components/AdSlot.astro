---
import { ADS_CONFIG } from '../config/adsConfig';

interface Props {
  slotType: keyof typeof ADS_CONFIG.slots;
  className?: string;
}

const { slotType, className = "" } = Astro.props;
const currentSlot = ADS_CONFIG.slots[slotType];
const combinedClasses = `ad-container-wrapper w-full !max-w-none mx-auto my-8 text-center clear-both h-full flex flex-col ${className} ${currentSlot?.style || ""}`.trim();
---

<div class={combinedClasses}>
  <span class="block text-[10px] font-bold tracking-wider text-slate-400 dark:text-slate-500 uppercase mb-2">
    Advertisement
  </span>

  {ADS_CONFIG.isLive ? (
    <ins class="adsbygoogle"
         style="display:block; text-align:center; height: 100%;"
         data-ad-client={ADS_CONFIG.publisherId}
         data-ad-slot={currentSlot?.slotId}
         data-ad-format={currentSlot?.format}
         data-full-width-responsive="true"></ins>
  ) : (
    <div class="relative flex-1 h-full flex flex-col border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/60 dark:bg-slate-900/40 rounded-2xl p-4 transition shadow-sm select-none group hover:border-blue-500 dark:hover:border-blue-400 duration-200">
      <div class="flex-1 w-full bg-gradient-to-br from-slate-800 to-slate-900 dark:from-slate-900 dark:to-slate-950 text-white rounded-xl p-5 shadow-inner flex flex-col justify-center items-center">
        <h4 class="font-['Cabinet_Grotesk'] font-bold text-xs uppercase tracking-widest text-blue-400 dark:text-indigo-400 mb-1">
          {currentSlot?.title || "Advertisement Unit"}
        </h4>
        <p class="text-[11px] text-slate-400 font-medium text-center">
          Premium Layout Reserve Space • Status: Framework Mocked
        </p>
      </div>
    </div>
  )}
</div>