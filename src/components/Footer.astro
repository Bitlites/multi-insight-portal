---
// Primary dynamic content tracking references
const categories = ["Current Affairs", "Technology", "Science", "Finance", "Social Studies"];
---

<footer class="bg-slate-900 dark:bg-slate-950 text-slate-400 text-sm mt-24 border-t border-slate-800 transition-colors duration-200">
	<div class="max-w-7xl mx-auto px-4 pt-16 pb-12">
		
		<!-- MAIN FOOTER GRID CONTAINER -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
			
			<!-- COLUMN 1: BRANDING & BRIEF DESCRIPTION -->
			<div class="space-y-4 flex flex-col items-start justify-start">
				<!-- Wrapped entire block in an absolute hyperlink for full clickability -->
				<a href="/" class="flex items-center gap-2.5 tracking-tight group shrink-0 select-none">
					
					<!-- PERFECT FOOTER ICON - MIRRORED FROM HEADER WITH SHRINK-0 FIX -->
					<div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white font-black text-lg shadow-sm border border-blue-500/20 group-hover:scale-105 transition-transform duration-200 shrink-0">
						<svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
						</svg>
					</div>
					
					<!-- Match name typography exactly with header tokens for uniform hover transition -->
					<span class="text-xl font-black text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-500 transition-colors duration-200">
						MULTI-INSIGHT <span class="text-blue-600 dark:text-blue-500">PORTAL</span>
					</span>
				</a>
				<p class="text-xs text-slate-400 leading-relaxed font-normal pt-1">
					A data-first static intelligence dashboard. We deliver speed-optimized analyses across science, technology, financial indicators, and global structural shifts.
				</p>

				<div class="flex flex-wrap items-center gap-2 pt-3.5">
					<!-- X / Twitter -->
					<a href="https://x.com" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-blue-600 text-slate-400 hover:text-white flex items-center justify-center border border-slate-700/50 transition-all duration-200" aria-label="Follow us on X (Twitter)">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
					</a>

					<!-- LinkedIn -->
					<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-blue-600 text-slate-400 hover:text-white flex items-center justify-center border border-slate-700/50 transition-all duration-200" aria-label="Connect on LinkedIn">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/>
						</svg>
					</a>

					<!-- Facebook -->
					<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-blue-600 text-slate-400 hover:text-white flex items-center justify-center border border-slate-700/50 transition-all duration-200" aria-label="Follow us on Facebook">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
						</svg>
					</a>

					<!-- Instagram -->
					<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-blue-600 text-slate-400 hover:text-white flex items-center justify-center border border-slate-700/50 transition-all duration-200" aria-label="Follow us on Instagram">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
						</svg>
					</a>

					<!-- YouTube -->
					<a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-blue-600 text-slate-400 hover:text-white flex items-center justify-center border border-slate-700/50 transition-all duration-200" aria-label="Subscribe to our YouTube Channel">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.867.502 5.751a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.867 24 12 24 12s0-3.868-.502-5.751zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
						</svg>
					</a>
				</div>
			</div>

			<!-- COLUMN 2: HUB SECTIONS -->
			<div>
				<h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4 font-mono">Content Categories</h3>
				<ul class="space-y-2.5 text-xs font-semibold">
					{categories.map((category) => (
						<li>
							<a 
								href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}`} 
								class="hover:text-blue-400 dark:hover:text-blue-500 transition-colors duration-150 block">
								{category}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- COLUMN 3: CORPORATE POLICIES (REQUIRED FOR GOOGLE ADSENSE) -->
			<div>
				<h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4 font-mono">Legal & Compliance</h3>
				<ul class="space-y-2.5 text-xs font-semibold">
					<li><a href="/about" class="hover:text-blue-400 dark:hover:text-blue-500 transition-colors block">About Our Team</a></li>
					<li><a href="/contact" class="hover:text-blue-400 dark:hover:text-blue-500 transition-colors block">Connect / Support</a></li>
					<li><a href="/privacy-policy" class="hover:text-blue-400 dark:hover:text-blue-500 transition-colors block">Privacy Policy</a></li>
					<li><a href="/terms" class="hover:text-blue-400 dark:hover:text-blue-500 transition-colors block">Terms of Service</a></li>
					<li><a href="/cookie-policy" class="hover:text-blue-400 dark:hover:text-blue-500 transition-colors block">Cookie Disclosure</a></li>
				</ul>
			</div>

			<!-- COLUMN 4: AUDIENCE ENGAGEMENT ACCELERATOR -->
			<div class="space-y-4">
				<h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-mono">Newsletter</h3>
				<p class="text-xs text-slate-400 leading-relaxed">
					Get static insight reports delivered straight to your terminal inbox every cycle.
				</p>
				<form action="#" class="flex gap-2" onsubmit="event.preventDefault();">
					<input 
						type="email" 
						required 
						placeholder="Enter email address..." 
						class="w-full bg-slate-800 text-white rounded-lg px-3 py-2 text-xs border border-slate-700 focus:outline-none focus:border-blue-500 transition-colors placeholder-slate-500 font-medium"/>
					<button 
						type="submit" 
						class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-3 py-2 rounded-lg text-xs tracking-wide uppercase transition-colors shrink-0 cursor-pointer">
						Join
					</button>
				</form>
			</div>
		</div>

		<!-- BOTTOM LICENSE BLOCK -->
		<div class="border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500 font-medium font-sans">
			<div>
				&copy; {new Date().getFullYear()} Multi-Insight Portal. All rights reserved globally.
			</div>
			<div class="flex gap-4 text-slate-400">
				<span>Empowering Global Knowledge</span>
				<span>•</span>
				<span>Optimized Analyses</span>
			</div>
		</div>
	</div>
</footer>